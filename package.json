{
  "name": "catamorbius",
  "version": "0.1.0",
  "description": "Webhook → CloudEvents → SSE event gateway (Jira, GitHub, extensible) with lossless retention and resumable streams",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooswit-factory/catamorbius.git"
  },
  "homepage": "https://github.com/brooswit-factory/catamorbius#readme",
  "bugs": {
    "url": "https://github.com/brooswit-factory/catamorbius/issues"
  },
  "scripts": {
    "generate": "bun run scripts/load/generate.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "check": "bun run generate && bun run typecheck && bun test test/unit test/load test/live test/e2e && bun run scripts/coverage/gate.ts && bun run scripts/verify-generated-is-committed.ts",
    "release:check": "bun run scripts/release/check.ts"
  },
  "dependencies": {
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "eventsource": "^5.1.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
