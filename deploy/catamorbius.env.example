# Template for the systemd unit's EnvironmentFile. Copy this to a real path
# (e.g. ~/.config/catamorbius/catamorbius.env), fill in real values, and
# chmod 600 it. Never commit a copy with real values filled in.

# TCP port to listen on.
PORT=3000

# Interface to bind. Keep this at 127.0.0.1 — this file is what actually
# decides it: systemd's EnvironmentFile= overrides the unit's own
# Environment=HOST=127.0.0.1 fallback if the two disagree (regardless of
# directive order), so changing this line changes what the gateway binds,
# with no firewall behind it to catch a mistake.
HOST=127.0.0.1

# Path to the sqlite log file. Must be on storage that survives a service
# restart and is NOT inside any agent workspace directory (those get
# rebuilt/deleted). Created on first start if missing.
CATAMORBIUS_DB=/absolute/path/to/a/stable/data/dir/catamorbius.sqlite

# Per-provider webhook secrets (provider name uppercased). Generate strong
# random values, e.g. `openssl rand -hex 32`. Without a provider's secret
# set, that provider's webhooks refuse with 503 (by design, not a bug).
WEBHOOK_SECRET_GITHUB=
WEBHOOK_SECRET_JIRA=

# Comma-separated bearer tokens accepted by GET /events. Without at least
# one configured, GET /events refuses with 503 (by design).
CATAMORBIUS_TOKENS=

# Leave unset in every real deployment: dev mode skips signature
# verification entirely and stores unverified deliveries.
# CATAMORBIUS_DEV_MODE=1

# Optional: milliseconds between SSE heartbeat comments. Defaults to 15000.
# CATAMORBIUS_HEARTBEAT_MS=15000
