[Unit]
Description=catamorbius (webhook -> CloudEvents -> SSE event gateway)
After=network.target

[Service]
EnvironmentFile=%h/.config/catamorbius/catamorbius.env
# Fallback default only: systemd's EnvironmentFile= always overrides
# Environment= for the same variable, regardless of which is listed first
# in this file (measured live, not assumed from the docs) — so this line
# does NOT enforce loopback against an env file that sets HOST differently.
# The real guarantee is that catamorbius.env.example also ships
# HOST=127.0.0.1; this Environment= line only covers a deployment whose env
# file omits HOST entirely.
Environment=HOST=127.0.0.1
WorkingDirectory=%h/deploy/catamorbius

ExecStart=%h/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
