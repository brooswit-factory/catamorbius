[Unit]
Description=catamorbius (webhook -> CloudEvents -> SSE event gateway)
After=network.target

[Service]
EnvironmentFile=%h/.config/catamorbius/catamorbius.env
# Pinned here, after EnvironmentFile, so it always wins over whatever the
# (per-deployment, operator-edited) env file does or doesn't set: this
# deployment stays localhost-only because the gateway itself binds loopback,
# not because of any host-wide firewall state.
Environment=HOST=127.0.0.1
WorkingDirectory=%h/deploy/catamorbius

ExecStart=%h/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
